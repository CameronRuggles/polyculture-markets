[Unit]
Description=Polyculture Markets — demo instance (stagenet)
Documentation=file:/opt/marketplace/DEPLOY-DEMO-RUNBOOK.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=marketplace
Group=marketplace
WorkingDirectory=/var/lib/marketplace
EnvironmentFile=/etc/marketplace/marketplace.env
ExecStart=/usr/local/bin/marketplace-app
Restart=on-failure
RestartSec=5

# Hardening: the app needs its state dir, /tmp, and loopback only.
# It never binds a public interface itself (BIND_ADDR is loopback;
# reach it via SSH tunnel or a TLS reverse proxy — see the runbook).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marketplace
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# Network egress denial (deployment audit DL2): the app only ever
# talks to PostgreSQL on loopback (§15 — no telemetry, no webhooks;
# media processing is local work). Deny all IP traffic except
# localhost; this is the kernel's cgroup firewall and is
# independent of RestrictAddressFamilies above (which limits the
# socket families the process may create at all).
# Measured with `systemd-analyze security --offline=yes` (systemd
# 255): exposure 2.1 "OK" after these lines, 7.7 "EXPOSED" before —
# the audit's bar was ≤ 3.0. The analyzer's remaining flags are
# outside the brief (PrivateNetwork/PrivateUsers would break the
# loopback/Postgres wiring; AF_INET/AF_UNIX must stay for it).
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=256
UMask=0077
SystemCallFilter=@system-service
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
# Media worker containment (CM2): the in-code layers are kill-on-drop
# on timeout and at most 2 concurrent workers. A memory ceiling is a
# deployment measure — this caps the whole unit (app + workers).
# For the bubblewrap sandbox around the worker itself, install
# bubblewrap and set MEDIA_WORKER_SANDBOX=bwrap in the env file.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
