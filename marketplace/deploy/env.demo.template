# Marketplace instance environment — DEMO profile (stagenet).
# Copy to /etc/marketplace/marketplace.env and fill in the CHANGE-ME
# values. This template contains NO real secrets: every credential is
# a placeholder you replace on the host, and the filled-in file must
# never be committed anywhere (mode 0600, owned by root).
#
# The values below are the stagenet demo defaults accepted by the
# owner on 2026-10-16 (PRE-MAINNET-CONFIRMATION-SHEET sections 2-3).

# --- Instance identity -------------------------------------------------
# Demo profile. The binary refuses mainnet in this profile even if
# INSTANCE_NETWORK is changed below — mainnet additionally requires
# the production profile and an exact confirmation sentence
# (crates/app/src/config.rs). Do not try to "upgrade" this file to
# mainnet; a production instance gets its own env file and its own
# sign-off.
DEPLOY_PROFILE=demo
INSTANCE_NETWORK=stagenet
MARKETPLACE_ID=vespiary-market
SITE_NAME=Polyculture Markets
BIND_ADDR=127.0.0.1:8080
# Where the source code for this instance is published (AGPL).
# The public repo exists; /source links it. Keep this set on any
# instance other people can reach — AGPL section 13 requires the
# offer of source to network users.
SOURCE_URL=https://github.com/CameronRuggles/polyculture-markets

# --- Database ------------------------------------------------------------
# Role + database are created by deploy-demo.sh. Replace CHANGE-ME
# with the password you set for the marketplace role (the same value
# must be used when creating the role — see DEPLOY-DEMO-RUNBOOK.md).
DATABASE_URL=postgres://marketplace:CHANGE-ME@127.0.0.1:5432/marketplace_demo

# --- Key file --------------------------------------------------------------
# The marketplace key file lives OUTSIDE the database and must be
# backed up separately from it (docs/operations.md). Losing it makes
# stored disclosures and TOTP secrets undecryptable and orphans
# buyer-token history.
KEY_FILE_PATH=/var/lib/marketplace/marketplace.key

# --- Hidden Trades statement identity ---------------------------------
# The instance's HT marketplace id (an mkt_... string) names this
# instance in every Hidden Trades statement the server pins and
# every helper checks against. Unless the id is fixed directly
# (HT_MARKETPLACE_ID below), it is minted once on first boot and
# persisted in the id file. The file is PER-INSTANCE and PERMANENT:
# back it up with the deployment, next to this env file (see
# docs/operations.md section 2). Losing it orphans every pinned
# terms statement and every configured helper, so outside the
# development profile the binary refuses to start when the file is
# missing rather than mint a replacement.
HT_ID_FILE_PATH=/var/lib/marketplace/marketplace.htid
# Alternative: fix the id in the environment and use no id file.
# Only for restoring an instance whose id file was lost but whose
# id is recorded elsewhere — the value must be the instance's
# EXISTING id, never a new one.
# HT_MARKETPLACE_ID=mkt_CHANGE-ME

# --- Media -------------------------------------------------------------------
MEDIA_DIR=/var/lib/marketplace/media
MEDIA_WORKER=/usr/local/bin/media-worker
# The media worker runs inside a bubblewrap sandbox (audit CM2): no
# network, a read-only root holding only the worker, the one input
# file and a per-job scratch dir. deploy-demo.sh installs bubblewrap
# and smoke-tests the sandbox before the service starts; if the
# sandbox cannot run, the deploy fails rather than shipping the
# worker unconfined. Removing this line turns the sandbox OFF.
MEDIA_WORKER_SANDBOX=bwrap

# --- Message blobs -------------------------------------------------------------
# Message ciphertext lives in FILES under BLOB_DIR (one <blob_ref>.asc
# per message); the database holds only the reference. Set this
# explicitly — the default is a relative "blobs/" under the process
# working directory, which is easy to lose track of. BLOB_DIR is part
# of every backup: database + key file WITHOUT the blob dir restores
# conversations whose message downloads all 404 (docs/operations.md §3).
BLOB_DIR=/var/lib/marketplace/blobs

# --- Direct Payments v1 (owner-accepted defaults, 2026-10-16) ---------------
PAYMENTS_MAX_BATCH=100
PAYMENTS_MAX_UNUSED_POOL=100
PAYMENTS_LOW_POOL_THRESHOLD=10
PAYMENTS_UNPAID_EXPIRY_HOURS=48
PAYMENTS_OPEN_UNPAID_CAP=3
PAYMENTS_ORDER_RATE_PER_HOUR=10
PAYMENTS_RESET_WARNING_DAYS=30
PAYMENTS_SWEEP_INTERVAL_SECS=900
# Server-side signature checking does not exist in v1 (no verifier);
# 0 is the only honest setting. Turning it on rejects uploads rather
# than verifying them.
PAYMENTS_SERVER_SIGNATURE_CHECK=0

# --- Retention (spec section 20 values) --------------------------------------
NOTIFICATIONS_READ_RETENTION_DAYS=30
SESSIONS_EXPIRED_RETENTION_DAYS=7
SECURITY_EVENTS_RETENTION_DAYS=30
RETENTION_INTERVAL_SECS=3600
