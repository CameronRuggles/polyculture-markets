# Marketplace instance environment — DEMO profile (stagenet).
# Copy to /etc/marketplace/marketplace.env and fill in the CHANGE-ME
# values. This template contains NO real secrets: every credential is
# a placeholder you replace on the host, and the filled-in file must
# never be committed anywhere (mode 0600, owned by root).
#
# The values below are the stagenet demo defaults accepted by the
# owner on 2026-10-16 (PRE-MAINNET-CONFIRMATION-SHEET sections 2-3).

# --- Instance identity -------------------------------------------------
# Demo profile. The binary refuses mainnet in this profile even if
# INSTANCE_NETWORK is changed below — mainnet additionally requires
# the production profile and an exact confirmation sentence
# (crates/app/src/config.rs). Do not try to "upgrade" this file to
# mainnet; a production instance gets its own env file and its own
# sign-off.
DEPLOY_PROFILE=demo
INSTANCE_NETWORK=stagenet
MARKETPLACE_ID=vespiary-market
SITE_NAME=Polyculture Markets
BIND_ADDR=127.0.0.1:8080
# Where the source code for this instance is published (AGPL).
# Leave unset until the public repo exists; /source explains the
# operator's duty either way.
# SOURCE_URL=

# --- Database ------------------------------------------------------------
# Role + database are created by deploy-demo.sh. Replace CHANGE-ME
# with the password you set for the marketplace role (the same value
# must be used when creating the role — see DEPLOY-DEMO-RUNBOOK.md).
DATABASE_URL=postgres://marketplace:CHANGE-ME@127.0.0.1:5432/marketplace_demo

# --- Key file --------------------------------------------------------------
# The marketplace key file lives OUTSIDE the database and must be
# backed up separately from it (docs/operations.md). Losing it makes
# stored disclosures and TOTP secrets undecryptable and orphans
# buyer-token history.
KEY_FILE_PATH=/var/lib/marketplace/marketplace.key

# --- Media -------------------------------------------------------------------
MEDIA_DIR=/var/lib/marketplace/media
MEDIA_WORKER=/usr/local/bin/media-worker

# --- Direct Payments v1 (owner-accepted defaults, 2026-10-16) ---------------
PAYMENTS_MAX_BATCH=100
PAYMENTS_MAX_UNUSED_POOL=100
PAYMENTS_LOW_POOL_THRESHOLD=10
PAYMENTS_UNPAID_EXPIRY_HOURS=48
PAYMENTS_OPEN_UNPAID_CAP=3
PAYMENTS_ORDER_RATE_PER_HOUR=10
PAYMENTS_RESET_WARNING_DAYS=30
PAYMENTS_SWEEP_INTERVAL_SECS=900
# Server-side signature checking does not exist in v1 (no verifier);
# 0 is the only honest setting. Turning it on rejects uploads rather
# than verifying them.
PAYMENTS_SERVER_SIGNATURE_CHECK=0

# --- Retention (spec section 20 values) --------------------------------------
NOTIFICATIONS_READ_RETENTION_DAYS=30
SESSIONS_EXPIRED_RETENTION_DAYS=7
SECURITY_EVENTS_RETENTION_DAYS=30
RETENTION_INTERVAL_SECS=3600
